# Database
DATABASE_URL=postgresql+asyncpg://postgres:23a07a19a77a@localhost:5432/web_platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# File upload
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/zip,text/x-python,application/javascript,text/css,text/html

# S3 (object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eduflow-files
S3_REGION=us-east-1

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_GENERAL=100/minute

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
